<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delaware Code Viewer"
        Height="820" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Brand / header -->
    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="Delaware Code Viewer"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Text="Browse and search the Delaware Code from locally archived title PDFs."
                   Foreground="{StaticResource MutedBrush}"
                   FontFamily="Segoe UI, Candara, sans-serif"
                   Margin="0,4,0,0"/>
      </StackPanel>
    </DockPanel>

    <!-- Search -->
    <Border Grid.Row="1"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12"
            Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox"
                 Grid.Column="0"
                 Height="34"
                 VerticalContentAlignment="Center"
                 Padding="8,0"
                 FontFamily="Segoe UI, Candara, sans-serif"
                 ToolTip="Full-text search across all titles"
                 KeyDown="SearchBox_KeyDown"/>
        <Button Grid.Column="1"
                Content="Search"
                Style="{StaticResource ToolbarButton}"
                Margin="10,0,0,0"
                Click="SearchButton_Click"/>
        <Button Grid.Column="2"
                Content="Clear"
                Style="{StaticResource ToolbarButton}"
                Background="{StaticResource MutedBrush}"
                Click="ClearSearch_Click"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" MinWidth="260"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="360"/>
      </Grid.ColumnDefinitions>

      <!-- Hierarchy -->
      <Border Grid.Column="0"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="Statute hierarchy"
                     FontWeight="SemiBold"
                     Margin="2,0,0,8"
                     FontFamily="Segoe UI, Candara, sans-serif"/>
          <TreeView x:Name="StatuteTree"
                    BorderThickness="0"
                    Background="Transparent"
                    SelectedItemChanged="StatuteTree_SelectedItemChanged"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Label}"
                           TextWrapping="Wrap"
                           Margin="0,2"/>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="8"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"/>

      <!-- Reader / search results -->
      <Border Grid.Column="2"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="ReaderKind"
                       FontFamily="Segoe UI, Candara, sans-serif"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="12"
                       Text="Select a statute unit"/>
            <TextBlock x:Name="ReaderPath"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       FontSize="16"
                       Margin="0,4,0,0"/>
          </StackPanel>

          <!-- Reader -->
          <ScrollViewer x:Name="ReaderScroll"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="ReaderText"
                       TextWrapping="Wrap"
                       LineHeight="24"
                       FontSize="15"/>
          </ScrollViewer>

          <!-- Search results overlay list -->
          <DockPanel x:Name="SearchResultsPanel"
                     Grid.Row="1"
                     Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top"
                       x:Name="SearchSummary"
                       Margin="0,0,0,8"
                       Foreground="{StaticResource MutedBrush}"
                       FontFamily="Segoe UI, Candara, sans-serif"/>
            <ListBox x:Name="SearchResultsList"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="SearchResultsList_MouseDoubleClick"
                     KeyDown="SearchResultsList_KeyDown">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding KindLabel}"
                               FontSize="11"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="Segoe UI, Candara, sans-serif"/>
                    <TextBlock Text="{Binding PathLabel}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Margin="0,2,0,2"/>
                    <TextBlock Text="{Binding Snippet}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3"
               x:Name="StatusText"
               Margin="2,10,0,0"
               Foreground="{StaticResource MutedBrush}"
               FontFamily="Segoe UI, Candara, sans-serif"
               Text="Loading..."/>
  </Grid>
</Window>
